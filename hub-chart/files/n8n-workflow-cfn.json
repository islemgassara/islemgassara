        "jsCode": "const contenu = `Contrat pour ${$input.first().json.nomClient}\\nG\u00e9n\u00e9r\u00e9 automatiquement par le Hub`;\n\nreturn [{\n  json: $input.first().json,\n  binary: {\n    document: await this.helpers.prepareBinaryData(Buffer.from(contenu), 'contrat.txt', 'text/plain')\n  }\n}];"
